# =============================================================================
# n8n Infrastructure – Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_32CHARS_MIN
POSTGRES_DB=n8n

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Leave empty for local development (no auth).
# In production ALWAYS set a strong password.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# n8n Core
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_A_VERY_LONG_AND_RANDOM_STRING_AT_LEAST_32_CHARS

GENERIC_TIMEZONE=Asia/Tehran

N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

N8N_HOST_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=0.0.0.0

# Optional: public webhook URL (behind reverse-proxy)
# WEBHOOK_URL=https://n8n.example.com/

# -----------------------------------------------------------------------------
# Connection URLs (parsed by start.sh)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://n8n:CHANGE_ME_TO_A_STRONG_PASSWORD_32CHARS_MIN@postgres:5432/n8n

REDIS_URL=redis://redis:6379

# Example with password:
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379